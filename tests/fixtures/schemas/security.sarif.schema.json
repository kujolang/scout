{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["$schema", "version", "runs"],
  "properties": {
    "$schema": {"const": "https://json.schemastore.org/sarif-2.1.0.json"},
    "version": {"const": "2.1.0"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool", "results"],
        "properties": {
          "tool": {
            "type": "object",
            "required": ["driver"],
            "properties": {
              "driver": {
                "type": "object",
                "required": ["name", "version", "rules"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "version": {"type": "string", "minLength": 1},
                  "informationUri": {"type": "string", "minLength": 1},
                  "rules": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["id", "name", "shortDescription", "properties"],
                      "properties": {
                        "id": {"type": "string", "minLength": 1},
                        "name": {"type": "string", "minLength": 1},
                        "shortDescription": {
                          "type": "object",
                          "required": ["text"],
                          "properties": {
                            "text": {"type": "string", "minLength": 1}
                          },
                          "additionalProperties": true
                        },
                        "properties": {
                          "type": "object",
                          "required": ["security-severity"],
                          "properties": {
                            "security-severity": {
                              "type": "string",
                              "enum": ["critical", "high", "medium", "low"]
                            }
                          },
                          "additionalProperties": true
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ruleId", "level", "message", "locations"],
              "properties": {
                "ruleId": {"type": "string", "minLength": 1},
                "level": {"type": "string", "enum": ["error", "warning", "note"]},
                "message": {
                  "type": "object",
                  "required": ["text"],
                  "properties": {
                    "text": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": true
                },
                "locations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["physicalLocation"],
                    "properties": {
                      "physicalLocation": {
                        "type": "object",
                        "required": ["artifactLocation", "region"],
                        "properties": {
                          "artifactLocation": {
                            "type": "object",
                            "required": ["uri"],
                            "properties": {
                              "uri": {"type": "string", "minLength": 1}
                            },
                            "additionalProperties": true
                          },
                          "region": {
                            "type": "object",
                            "required": ["startLine"],
                            "properties": {
                              "startLine": {"type": "integer", "minimum": 1}
                            },
                            "additionalProperties": true
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
