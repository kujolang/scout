{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "packages"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "latest", "metadata_path", "versions"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "latest": {"type": "string", "minLength": 1},
          "metadata_path": {"type": "string", "pattern": "^packages/.+\\.json$"},
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["version", "source", "ref"],
              "properties": {
                "version": {"type": "string", "minLength": 1},
                "source": {"type": "string", "minLength": 1},
                "ref": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
