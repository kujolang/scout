{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "tool", "target", "output", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "target": {"type": "string", "minLength": 1},
    "output": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "object",
      "required": ["file_tree", "report", "llms", "agents", "checklist", "intelligence"],
      "properties": {
        "file_tree": {"type": "string", "const": "FILE_TREE.md"},
        "report": {"type": "string", "const": "README.md"},
        "llms": {"type": "string", "const": "llms.txt"},
        "agents": {"type": "string", "const": "AGENTS.md"},
        "checklist": {"type": "string", "const": "CHECKLIST.md"},
        "intelligence": {"type": "string", "const": "intelligence.json"},
        "security_sarif": {"type": "string", "const": "security.sarif"},
        "security_jsonl": {"type": "string", "const": "security.jsonl"},
        "kennel_index": {"type": "string", "const": "index.json"},
        "kennel_metadata": {"type": "string", "pattern": "^packages/.+\\.json$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
