# Native string sorting preserves the existing composite-key ordering.
# Distinct records can share a key (for example when a path contains "|").
func sort_records(items, key_for) {
    if len(items) < 2 {
        return items
    }

    groups := {}
    has_ties := false
    for item in items {
        key := key_for(item)
        if has_key(groups, key) {
            previous := groups[key]
            if type(previous) != "array" {
                previous := [previous]
            }
            groups[key] := push(previous, item)
            has_ties := true
        } else {
            groups[key] := item
        }
    }

    # Kujo's values() traverses string-keyed dictionaries in sorted key order.
    ordered := values(groups)
    if has_ties {
        return flatten(ordered)
    }
    return ordered
}

# Security findings have a multi-field comparator with a numeric line number.
func sort_security_findings(items) {
    if len(items) < 2 {
        return items
    }

    values := items
    merged := range(0, len(items))
    width := 1
    while width < len(values) {
        start := 0
        while start < len(values) {
            middle := min(start + width, len(values))
            end := min(start + width + width, len(values))
            left := start
            right := middle
            index := start
            while left < middle || right < end {
                take_left := right >= end
                if left < middle && right < end {
                    take_left := !security_finding_after(values[left], values[right])
                }
                if take_left {
                    merged[index] := values[left]
                    left := left + 1
                } else {
                    merged[index] := values[right]
                    right := right + 1
                }
                index := index + 1
            }
            start := end
        }
        previous := values
        values := merged
        merged := previous
        previous := []
        width := width * 2
    }
    return values
}

func dependency_sort_key(dep) {
    return to_string(dep["module"]) + "|" + to_string(dep["type"]) + "|" + to_string(dep["source"])
}

func route_sort_key(route) {
    return to_string(route["method"]) + "|" + to_string(route["path"]) + "|" + to_string(route["source"])
}

func security_severity_rank(severity) {
    if severity == "critical" {
        return "0"
    }
    if severity == "high" {
        return "1"
    }
    if severity == "medium" {
        return "2"
    }
    return "3"
}

func security_finding_after(left, right) {
    left_rank := security_severity_rank(to_string(left["severity"]))
    right_rank := security_severity_rank(to_string(right["severity"]))
    if left_rank != right_rank {
        return left_rank > right_rank
    }

    left_file := to_string(left["file"])
    right_file := to_string(right["file"])
    if left_file != right_file {
        return left_file > right_file
    }

    left_line := to_int(left["line"])
    right_line := to_int(right["line"])
    if left_line != right_line {
        return left_line > right_line
    }

    return to_string(left["label"]) > to_string(right["label"])
}

func sort_strings_asc(items) {
    return sort(items)
}

func sort_dependencies(items) {
    return sort_records(items, dependency_sort_key)
}

func sort_routes(items) {
    return sort_records(items, route_sort_key)
}

export sort_strings_asc := sort_strings_asc
export sort_dependencies := sort_dependencies
export sort_routes := sort_routes
export sort_security_findings := sort_security_findings
