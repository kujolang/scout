func sort_strings_asc(items) {
    sorted := []
    for item in items {
        sorted := push(sorted, item)
    }

    i := 1
    while i < len(sorted) {
        key_item := sorted[i]
        j := i - 1
        while j >= 0 && sorted[j] > key_item {
            sorted[j + 1] := sorted[j]
            j := j - 1
        }
        sorted[j + 1] := key_item
        i := i + 1
    }

    return sorted
}

func dependency_sort_key(dep) {
    return to_string(dep["module"]) + "|" + to_string(dep["type"]) + "|" + to_string(dep["source"])
}

func route_sort_key(route) {
    return to_string(route["method"]) + "|" + to_string(route["path"]) + "|" + to_string(route["source"])
}

func security_severity_rank(severity) {
    if severity == "critical" {
        return "0"
    }
    if severity == "high" {
        return "1"
    }
    if severity == "medium" {
        return "2"
    }
    return "3"
}

func security_sort_key(finding) {
    return security_severity_rank(to_string(finding["severity"])) + "|" + to_string(finding["file"]) + "|" + to_string(finding["line"])
}

func security_finding_after(left, right) {
    left_rank := security_severity_rank(to_string(left["severity"]))
    right_rank := security_severity_rank(to_string(right["severity"]))
    if left_rank != right_rank {
        return left_rank > right_rank
    }

    left_file := to_string(left["file"])
    right_file := to_string(right["file"])
    if left_file != right_file {
        return left_file > right_file
    }

    left_line := to_int(left["line"])
    right_line := to_int(right["line"])
    if left_line != right_line {
        return left_line > right_line
    }

    return to_string(left["label"]) > to_string(right["label"])
}

func sort_dependencies(items) {
    sorted := []
    for item in items {
        sorted := push(sorted, item)
    }

    i := 1
    while i < len(sorted) {
        key_item := sorted[i]
        key_sort := dependency_sort_key(key_item)
        j := i - 1
        while j >= 0 && dependency_sort_key(sorted[j]) > key_sort {
            sorted[j + 1] := sorted[j]
            j := j - 1
        }
        sorted[j + 1] := key_item
        i := i + 1
    }

    return sorted
}

func sort_routes(items) {
    sorted := []
    for item in items {
        sorted := push(sorted, item)
    }

    i := 1
    while i < len(sorted) {
        key_item := sorted[i]
        key_sort := route_sort_key(key_item)
        j := i - 1
        while j >= 0 && route_sort_key(sorted[j]) > key_sort {
            sorted[j + 1] := sorted[j]
            j := j - 1
        }
        sorted[j + 1] := key_item
        i := i + 1
    }

    return sorted
}

func sort_security_findings(items) {
    sorted := []
    for item in items {
        sorted := push(sorted, item)
    }

    i := 1
    while i < len(sorted) {
        key_item := sorted[i]
        j := i - 1
        while j >= 0 && security_finding_after(sorted[j], key_item) {
            sorted[j + 1] := sorted[j]
            j := j - 1
        }
        sorted[j + 1] := key_item
        i := i + 1
    }

    return sorted
}

export sort_strings_asc := sort_strings_asc
export sort_dependencies := sort_dependencies
export sort_routes := sort_routes
export sort_security_findings := sort_security_findings
