# Scout v1.0.0 (Kujo-native)

from lib.path_filters import basename_from_path, sanitize_slug, normalize_filter_text, pattern_match, any_pattern_match, is_path_within_target, relative_path_from_target, format_output_path
from lib.sorting import sort_strings_asc, sort_dependencies, sort_routes, sort_security_findings
from lib.security_exports import build_sarif_security_export, build_jsonl_security_export, build_security_fingerprint
from lib.text_scan import find_after, first_quoted_value, is_escaped_char, is_inside_quoted_literal, contains_dangerous_exec_call

VERSION := "1.0.0"
SCOUT_RUNTIME_LOADED := true
export SCOUT_RUNTIME_LOADED := SCOUT_RUNTIME_LOADED
TARGET := "."
OUTPUT_ROOT := "./results"
OUTPUT := ""
MAX_DEPTH := 6
MAX_FILE_SIZE := 500000
SKIP_SEC := false
SKIP_DEPS := false
SKIP_ROUTES := false
CONFIG_PATH := "config.json"
IGNORE_FILE := ".scoutignore"
INCLUDE_PATTERNS := []
EXCLUDE_PATTERNS := []
PATH_MODE := "relative"
SECURITY_EXPORT_FORMATS := []
SECURITY_EXPORT_SEEN := {}
BASELINE_FILE := "scout-baseline.json"
SHOW_SUPPRESSED := false
WRITE_BASELINE := false
EMIT_KENNEL_INDEX := false
EMIT_KENNEL_METADATA := false
METRICS_ENABLED := true
OUTPUT_PROFILE := "full"

LANGUAGE_MAP := {
    ".py": "Python",
    ".js": "JavaScript",
    ".mjs": "JavaScript",
    ".cjs": "JavaScript",
    ".ts": "TypeScript",
