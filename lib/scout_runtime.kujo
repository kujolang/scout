MANIFEST_FILES := {
    "package.json": true,
    "composer.json": true,
    "pyproject.toml": true,
    "Cargo.toml": true,
    "cargo.toml": true,
    "go.mod": true,
    "requirements.txt": true,
    "Gemfile": true
}

IGNORED_DIRS := {
    ".git": true,
    ".svn": true,
    ".hg": true,
    "node_modules": true,
    "vendor": true,
    "target": true,
    "dist": true,
    "build": true,
    ".next": true,
    ".nuxt": true,
    ".venv": true,
    "venv": true,
    "env": true,
    "__pycache__": true,
    ".pytest_cache": true,
    ".mypy_cache": true,
    ".kujo_cache": true,
    ".cache": true,
    "tmp": true,
    "temp": true,
    "logs": true
}

IGNORED_EXTS := {
    ".jpg": true,
    ".jpeg": true,
    ".png": true,
    ".gif": true,
    ".bmp": true,
    ".ico": true,
    ".webp": true,
