    ".ttf": true,
    ".eot": true,
    ".pdf": true,
    ".zip": true,
    ".tar": true,
    ".gz": true,
    ".bz2": true,
    ".7z": true,
    ".rar": true,
    ".so": true,
    ".dll": true,
    ".dylib": true,
    ".exe": true,
    ".bin": true,
    ".o": true,
    ".a": true,
    ".class": true,
    ".jar": true,
    ".war": true,
